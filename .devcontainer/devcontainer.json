// Opens a ready terminal in the browser (GitHub Codespaces) with everything setup.sh needs:
// Node 22, the GitHub CLI and the Supabase CLI (pinned v2.122.0). Nothing to install on your computer.
{
  "name": "myfinances setup",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "curl -fsSL https://github.com/supabase/cli/releases/download/v2.122.0/supabase_linux_$(dpkg --print-architecture).tar.gz | sudo tar -xz -C /usr/local/bin supabase && npm ci --omit=dev",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "postAttachCommand": "cat .devcontainer/welcome.txt"
}
