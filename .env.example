# Copy to .env and fill in. Used by the local sync/notify scripts (run via
# launchd/cron, or docker compose), not by the Supabase Edge Functions --
# those get their secrets from the Supabase Dashboard instead (see
# supabase/functions/README.md).

# Enable Banking (https://enablebanking.com) -- PSD2 open banking API.
APP_ID=
# Either a path to the .pem file (local/launchd) or PRIVATE_KEY with the
# key's content directly (docker compose -- there's no host filesystem to
# point a path at). Set whichever one applies; leave the other blank.
PRIVATE_KEY_FILE=
PRIVATE_KEY=

# Supabase project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Enable Banking consent session length, in days.
SESSION_VALID_UNTIL=90

# Gemini API key, used to auto-categorize transactions.
GEMINI_API_KEY=

# Your Supabase auth user id. Only used by the single-user scripts
# (portfolio/crypto price sync, worth-it notifications) -- bank transaction
# sync itself loops over every linked user automatically.
USER_ID=

# Coinbase API (optional, only if you track crypto holdings via Coinbase).
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Web Push VAPID keys, for "worth it?" notifications. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# docker compose only: baked into the frontend's client bundle at build
# time (see my-wealth-view/.env.example for what these are).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
